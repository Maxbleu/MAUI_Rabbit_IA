<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_rabbit_mq_cliente_1.Views.SettingsRabbitMQPage"
             xmlns:Shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:MauiApp_rabbit_mq_cliente_1.ViewModels">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                       Text="Settings RabbitMQ" 
                       FontSize="20" 
                       FontAttributes="Bold"/>

            <Shapes:Ellipse 
                        Grid.Column="1"
                        WidthRequest="50" 
                        HeightRequest="50" 
                        Fill="{Binding Color}" 
                        Stroke="Gray" 
                        StrokeThickness="10"
                        HorizontalOptions="End"/>

        </Grid>

        <StackLayout Grid.Row="1" Margin="0,20,0,0">
            <Label Text="HostName" FontSize="16"/>
            <Entry Grid.Row="1" Text="{Binding HostName}"
                   Placeholder="Hostname" 
                   FontSize="16"/>
        </StackLayout>

        <StackLayout Grid.Row="2" Margin="0,20,0,0">
            <Label Text="Exchange name" FontSize="16"/>
            <Entry Grid.Row="1" Text="{Binding ExchangeName}"
                   Placeholder="Exchange name" 
                   FontSize="16"/>
        </StackLayout>

        <Button Grid.Row="3"
                Text="Guardar"
                Margin="0,20,0,0"
                Command="{Binding SaveConfigurationCommand}"
                IsEnabled="{Binding IsEnabledButton}"/>

    </Grid>

</ContentPage>